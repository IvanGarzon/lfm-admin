{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "bracketSpacing": true,
  "semi": true,
  "useTabs": false,
  "trailingComma": "all",
  "jsxSingleQuote": true,
  "singleQuote": true,
  "printWidth": 100,
  "tabWidth": 2,
  "endOfLine": "lf",
  "experimentalSortTailwindcss": true,
  "ignorePatterns": [
    "**/dist/**",
    "**/.dist/**",
    "**/build/**",
    "**/.build/**",
    "**/node_modules/**",
    "**/generated/**",
    "**/.next/**",
    "**/.vite/**",
    ".tmp/**",
    "tmp/**",
    "out/**",
    "scripts/**",
    ".turbo/**",
    "**/locales/**",
    "**/coverage/**",
    "**/public/**",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "CHANGELOG.md"
  ],
  "overrides": [
    {
      "files": ["*.md", "*.mdc"],
      "options": {
        "proseWrap": "preserve"
      }
    }
  ]
}
